# Copy to .env. Never commit .env to a shared repository.
FLASK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER=localhost
SQL_DATABASE=NEWCORP_DB
# Windows Authentication (leave SQL_USER empty):
SQL_USER=
SQL_PASSWORD=
# If using SQL login, supply SQL_USER and SQL_PASSWORD.
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
COOKIE_SECURE=false
PORT=5000
# Or use SQL_CONNECTION_STRING to override all SQL_* connection settings.
