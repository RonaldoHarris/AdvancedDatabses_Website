# Template only. Actual credentials belong in Render environment variables.

FLASK_SECRET_KEY=replace_with_a_long_random_value

SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=NEWCORP_DB
SQL_USER=your_sql_username
SQL_PASSWORD=your_sql_password

SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no

COOKIE_SECURE=true
PORT=5000
